# ==============================================================
# Wisdom International School - Backend Environment Variables
# ==============================================================

# Server Network Configuration (Supports dynamic ports on Render/Railway/AWS/Heroku)
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, AWS RDS, Render, Local)
# For cloud databases with SSL, sslmode=require is automatically handled.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wisdom_school

# JWT Secret Key for Admin Authentication Sessions
JWT_SECRET=wisdom-school-jwt-secret-key-2026-secure-replace-in-prod

# Allowed Frontend Origins for CORS (Comma-separated for multiple production domains)
FRONTEND_URL=https://wisdomschool.org,https://www.wisdomschool.org,http://localhost:3000

# Optional Database Pool Tuning
DB_MAX_CONNECTIONS=20
DB_CONNECT_TIMEOUT_MS=8000
