# ==============================================================
# Wisdom International School - Frontend Environment Variables
# ==============================================================

# Backend API URL (Used by Next.js rewrite proxy to forward /api/* requests)
# Set to your deployed backend URL in production (e.g. https://api.wisdomschool.org or Render/Railway URL)
BACKEND_URL=http://127.0.0.1:5000

# Optional Direct PostgreSQL Database URL (for server actions/Next.js standalone API routes)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wisdom_school
